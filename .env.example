# ─────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./tiktok_robox.db
# For production: postgresql+asyncpg://user:pass@host:5432/tiktok_robox

# ─────────────────────────────────────────────
# PIPELINE
# ─────────────────────────────────────────────
DISCOVERY_INTERVAL_HOURS=4
MAX_QUEUE_SIZE=150
TARGET_DAILY_POSTS=3
MIN_VIRAL_SCORE=0.45

# ─────────────────────────────────────────────
# CONTENT GENERATION
# ─────────────────────────────────────────────
ANTHROPIC_MODEL=claude-sonnet-4-6
THUMBNAIL_VARIANTS=2
VIDEO_FPS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
TTS_PROVIDER=gtts
# TTS_PROVIDER=elevenlabs  (higher quality, paid)
ELEVENLABS_API_KEY=

# ─────────────────────────────────────────────
# BRANDING
# ─────────────────────────────────────────────
CHANNEL_NAME=RobloxGems
CHANNEL_HANDLE=@robloxgems
BRAND_PRIMARY_COLOR=#6C63FF
BRAND_SECONDARY_COLOR=#FF6584
BRAND_ACCENT_COLOR=#FFD700

# ─────────────────────────────────────────────
# SCORING WEIGHTS (sum should equal 1.0)
# ─────────────────────────────────────────────
WEIGHT_GROWTH_VELOCITY=0.30
WEIGHT_ENGAGEMENT_RATIO=0.20
WEIGHT_NOVELTY=0.15
WEIGHT_RETENTION_PROXY=0.15
WEIGHT_UPDATE_FRESHNESS=0.10
WEIGHT_CROSS_PLATFORM=0.10

# ─────────────────────────────────────────────
# PATHS
# ─────────────────────────────────────────────
OUTPUT_DIR=output
ASSETS_DIR=assets

# ─────────────────────────────────────────────
# DASHBOARD
# ─────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_SECRET_KEY=change-this-in-production
